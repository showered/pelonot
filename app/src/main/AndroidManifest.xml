<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      Haptic interval alerts. Without this the vibrator service throws a
      SecurityException that RideCoach catches, so the buzz simply never
      happens and nothing says why — which is exactly what it did.
    -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      Declared for completeness against Peloton's sensor service. It is a
      signature-level permission we can never be granted, and the service's
      <service> tag sets no android:permission, so it is not enforced and the
      bind succeeds without it. Listed so the dependency is visible rather than
      implied by a bare bindService call.
    -->
    <uses-permission android:name="onepeloton.permission.ACCESS_SENSOR_SERVICE" />

    <!--
      Package visibility filtering (targetSdk 30+) hides other packages from
      us, and an invisible package makes bindService fail with no useful error.
    -->
    <queries>
        <package android:name="com.peloton.service.SensorData" />
    </queries>

    <application
        android:name=".PelonotApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pelonot">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Pelonot">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".data.service.WorkoutService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

    </application>

</manifest>