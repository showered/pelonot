<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!--
      BLE heart rate. The permission model splits at API 31, and both halves
      have to be declared or the half that applies to the running device is
      dead: a runtime request for a permission absent from the manifest is
      denied instantly, with no dialog and nothing in the log.

      That is not hypothetical — ACCESS_FINE_LOCATION was missing here, so on
      the bike's own Android 11 tablet Settings could only ever say "Pelonot
      needs Bluetooth permission" and no strap could ever be found. Below API
      31 there is no BLUETOOTH_SCAN to fall back on; location *is* the scan
      permission. Same failure shape as VIBRATE above.
    -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <!--
      maxSdkVersion so API 31+ is never asked for location: it has
      BLUETOOTH_SCAN instead, and asking a modern device for the rider's
      location to read their heart rate is a permission prompt that deserves
      to be refused.
    -->
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />
    <!--
      neverForLocation: we scan for a heart rate service UUID and derive no
      location from the results, which lets API 31+ grant the scan without
      dragging location into it.
    -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      Haptic interval alerts. Without this the vibrator service throws a
      SecurityException that RideCoach catches, so the buzz simply never
      happens and nothing says why — which is exactly what it did.
    -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      Media volume (PLAN 11.5). The bike's tablet has no status bar to pull
      down and therefore no system volume UI at all, so the app is the only
      surface that can change how loud the rider's film is.

      Declared *before* the slider was wired, because a runtime call behind an
      undeclared permission fails silently and this project has shipped that
      exact bug twice (VIBRATE above, ACCESS_FINE_LOCATION below). This one is
      normal/install-time, so there is no prompt and nothing to grant.
    -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!--
      Declared for completeness against Peloton's sensor service. It is a
      signature-level permission we can never be granted, and the service's
      <service> tag sets no android:permission, so it is not enforced and the
      bind succeeds without it. Listed so the dependency is visible rather than
      implied by a bare bindService call.
    -->
    <uses-permission android:name="onepeloton.permission.ACCESS_SENSOR_SERVICE" />

    <!--
      Package visibility filtering (targetSdk 30+) hides other packages from
      us, and an invisible package makes bindService fail with no useful error.
    -->
    <queries>
        <package android:name="com.peloton.service.SensorData" />
    </queries>

    <application
        android:name=".PelonotApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pelonot">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Pelonot">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".data.service.WorkoutService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

    </application>

</manifest>