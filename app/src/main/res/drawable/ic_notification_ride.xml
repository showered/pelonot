    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFFFF">

    <!-- Rear wheel -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M5.5,20.5m-3.5,0a3.5,3.5 0 1,1 7,0a3.5,3.5 0 1,1 -7,0M5.5,20.5m-2,0a2,2 0 1,0 4,0a2,2 0 1,0 -4,0" />

    <!-- Front wheel -->
