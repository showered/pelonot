        android:fillColor="#FFFFFFFF"
        android:pathData="M18.5,20.5m-3.5,0a3.5,3.5 0 1,1 7,0a3.5,3.5 0 1,1 -7,0M18.5,20.5m-2,0a2,2 0 1,0 4,0a2,2 0 1,0 -4,0" />

    <!-- Frame, cranks and bars -->
